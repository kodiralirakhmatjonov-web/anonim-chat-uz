{
  "name": "anonymous-chat-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "db:migrate:local": "wrangler d1 migrations apply anonymous-chat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply anonymous-chat-db --remote",
    "webhook:set": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260827.1",
    "typescript": "5.9.2",
    "wrangler": "4.127.0"
  }
}
