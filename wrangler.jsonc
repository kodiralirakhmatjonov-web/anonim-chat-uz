{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anonymous-chat-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anonymous-chat-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
